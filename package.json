{
  "name": "type-share-eden-elysia",
  "version": "0.1.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/ripabak/type-share-eden-elysia.git"
  },
  "description": "Share Elysia types to frontend via HTTP endpoint",
  "author": "ripabak",
  "license": "MIT",
  "bin": {
    "type-share-eden-elysia": "dist/cli.js"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "bun run src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "elysia": "^1.4.28"
  },
  "peerDependencies": {
    "elysia": "^1.4.28"
  }
}
