{
  "name": "type-share-eden-elysia",
  "version": "0.0.1",
  "description": "Share Elysia types to frontend via HTTP endpoint",
  "author": "ripabak",
  "license": "MIT",
  "bin": {
    "type-share-eden-elysia": "dist/cli.js"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "bun run src/index.ts"
  },
  "dependencies": {
    "elysia": "^1.4.28"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/bun": "^1.3.13"
  }
}